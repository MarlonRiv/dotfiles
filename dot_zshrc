# Find the root of the ROS2 package containing a given directory
function _ros_pkg_root() {
    local dir="${1:-$PWD}"
    while [[ "$dir" != "/" ]]; do
        [[ -f "$dir/package.xml" ]] && { echo "$dir"; return 0; }
        dir=$(dirname "$dir")
    done
    return 1
}

# Format (or check) C++ code using the exact same method as ament_clang_format
#
# Usage:
#   ros_fmt                        # format current package
#   ros_fmt pkg1 pkg2              # format named packages in $ROS_WORKSPACE
#   ros_fmt --check                # check current package (no changes)
#   ros_fmt --check pkg1 pkg2      # check named packages
function ros_fmt() {
    ros2_env

    local reformat="--reformat"
    local packages=()

    for arg in "$@"; do
        [[ "$arg" == "--check" ]] && reformat="" || packages+=("$arg")
    done

    local _fmt_one() {
        local pkg_root="$1"
        local pkg_name=$(basename "$pkg_root")
        local config="$pkg_root/.clang-format"

        if [[ ! -f "$config" ]]; then
            echo "⚠  $pkg_name: no .clang-format found, skipping"
            return 1
        fi

        local dirs=()
        [[ -d "$pkg_root/src" ]]     && dirs+=("$pkg_root/src")
        [[ -d "$pkg_root/include" ]] && dirs+=("$pkg_root/include")
        [[ -d "$pkg_root/test" ]]    && dirs+=("$pkg_root/test")

        if [[ ${#dirs[@]} -eq 0 ]]; then
            echo "⚠  $pkg_name: no src/ or include/ found, skipping"
            return 1
        fi

        if [[ -n "$reformat" ]]; then
            echo "🎨 Formatting $pkg_name ..."
        else
            echo "🔍 Checking $pkg_name ..."
        fi

        /opt/ros/jazzy/bin/ament_clang_format $reformat \
            --config "$config" "${dirs[@]}"
    }

    if [[ ${#packages[@]} -eq 0 ]]; then
        local root
        root=$(_ros_pkg_root "$PWD") || { echo "❌ Not inside a ROS2 package"; return 1; }
        _fmt_one "$root"
    else
        for pkg in "${packages[@]}"; do
            local path
            path=$(command colcon --log-base /dev/null list \
                --packages-select "$pkg" --paths-only 2>/dev/null)
            if [[ -z "$path" ]]; then
                echo "❌ Package '$pkg' not found in $ROS_WORKSPACE"
                continue
            fi
            _fmt_one "$ROS_WORKSPACE/$path"
        done
    fi
}

