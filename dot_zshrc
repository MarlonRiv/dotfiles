# Reset function to clean PATH
function reset_env() {
    export PATH="/usr/bin:/usr/local/bin:/bin:/sbin:/usr/sbin"
    unset ROS_DISTRO ROS_VERSION ROS_PYTHON_VERSION ROS_LOCALHOST_ONLY \
          ROS_AUTOMATIC_DISCOVERY_RANGE RMW_IMPLEMENTATION \
          AMENT_PREFIX_PATH CMAKE_PREFIX_PATH COLCON_PREFIX_PATH \
          ROS_PACKAGE_PATH PYTHONPATH LD_LIBRARY_PATH \
          PKG_CONFIG_PATH AMENT_CURRENT_PREFIX
    echo "Environment reset to system defaults" >&2
}

